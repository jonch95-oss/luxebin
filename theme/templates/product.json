{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'luxebin-vendor-link', product: product %}"
          }
        },
        "title": {
          "type": "title",
          "settings": {}
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false
          }
        },
        "authentic": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'luxebin-authentic', product: product %}"
          }
        },
        "accordions": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'luxebin-accordions', product: product, section_id: section.id %}"
          }
        },
        "sticky": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'luxebin-sticky-atc', product: product, section_id: section.id %}"
          }
        },
        "rating": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"jdgm-widget jdgm-preview-badge\" data-id=\"{{ product.id }}\">{{ product.metafields.judgeme.badge }}</div>"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "rating",
        "price",
        "variant_picker",
        "buy_buttons",
        "authentic",
        "accordions",
        "sticky"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail_slider",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "portrait",
        "image_shape": "default",
        "show_secondary_image": false,
        "show_vendor": true,
        "show_rating": true,
        "columns_mobile": "2",
        "padding_top": 64,
        "padding_bottom": 64
      }
    },
    "reviews": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<div class=\"page-width lx-reviews\"><h2 class=\"lx-h2\">Reviews</h2><div id=\"judgeme_product_reviews\" class=\"jdgm-widget jdgm-review-widget\" data-id=\"{{ product.id }}\">{{ product.metafields.judgeme.widget }}</div></div>",
        "color_scheme": "scheme-1",
        "padding_top": 48,
        "padding_bottom": 0
      }
    }
  },
  "order": [
    "main",
    "reviews",
    "related-products"
  ]
}