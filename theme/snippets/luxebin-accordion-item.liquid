{%- comment -%} One product-page accordion row in Dawn's markup. Accepts: id, title, content, open {%- endcomment -%}
<div class="product__accordion accordion quick-add-hidden">
  <details id="Details-{{ id }}"{% if open %} open{% endif %}>
    <summary>
      <div class="summary__title">
        <h2 class="h4 accordion__title">{{ title }}</h2>
      </div>
      {{- 'icon-caret.svg' | inline_asset_content -}}
    </summary>
    <div class="accordion__content rte" id="ProductAccordion-{{ id }}">
      {{ content }}
    </div>
  </details>
</div>
