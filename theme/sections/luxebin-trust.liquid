{{ 'luxebin-sections.css' | asset_url | stylesheet_tag }}
<section class="lx-trust" aria-label="{{ section.settings.label | escape }}">
  <div class="lx-wrap lx-trust__grid">
    {%- for block in section.blocks -%}
      <div class="lx-trust__item" {{ block.shopify_attributes }}>
        {%- case block.settings.icon -%}
          {%- when 'shield' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4.5 6v5.5c0 4.6 3.1 8.2 7.5 9.5 4.4-1.3 7.5-4.9 7.5-9.5V6z"/><path d="m8.8 12 2.2 2.2 4.2-4.4"/></svg>
          {%- when 'box' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 7.5 12 3l8.5 4.5v9L12 21l-8.5-4.5z"/><path d="M3.5 7.5 12 12l8.5-4.5M12 12v9"/></svg>
          {%- when 'lock' -%}<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="10.5" width="14" height="9.5" rx="1"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/></svg>
          {%- else -%}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="17.5" r="1.6"/><circle cx="17.5" cy="17.5" r="1.6"/></svg>
        {%- endcase -%}
        <h3>{{ block.settings.title }}</h3>
        {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Luxebin trust bar",
  "tag": "div",
  "class": "section",
  "settings": [{ "type": "text", "id": "label", "label": "Accessible label", "default": "Our promises" }],
  "blocks": [
    { "type": "item", "name": "Promise", "settings": [
      { "type": "select", "id": "icon", "label": "Icon", "default": "shield", "options": [
        { "value": "shield", "label": "Shield" }, { "value": "box", "label": "Box" }, { "value": "lock", "label": "Lock" }, { "value": "truck", "label": "Truck" }
      ] },
      { "type": "text", "id": "title", "label": "Title" },
      { "type": "text", "id": "text", "label": "Text" }
    ] }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Luxebin trust bar" }]
}
{% endschema %}
