{{ 'luxebin-sections.css' | asset_url | stylesheet_tag }}
<section class="lx-sec lx-news lx-wrap" aria-labelledby="LxNews-{{ section.id }}">
  <div class="lx-news__in">
    <div>
      {%- if section.settings.eyebrow != blank -%}<p class="lx-caps lx-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 id="LxNews-{{ section.id }}">{{ section.settings.heading }}{% if section.settings.heading_em != blank %} <em>{{ section.settings.heading_em }}</em>{% endif %}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div>
      {%- assign news_form_id = 'LxNewsForm-' | append: section.id -%}
      {%- form 'customer', id: news_form_id -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="lx-news__form">
          <label class="visually-hidden" for="LxNewsEmail-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
          <input id="LxNewsEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" autocorrect="off" autocapitalize="off" placeholder="Your email address" required {% if form.errors %}aria-invalid="true"{% endif %}>
          <button type="submit">Subscribe</button>
        </div>
        {%- if form.errors -%}
          <p class="lx-news__msg" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- elsif form.posted_successfully? -%}
          <p class="lx-news__msg" role="status">{{ 'newsletter.success' | t }}</p>
        {%- endif -%}
      {%- endform -%}
      {%- if section.settings.small != blank -%}<small>{{ section.settings.small }}</small>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Luxebin newsletter",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Luxebin List" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the list," },
    { "type": "text", "id": "heading_em", "label": "Heading (italic part)", "default": "take 10% off." },
    { "type": "text", "id": "text", "label": "Text", "default": "First word on new arrivals, restocks and private offers." },
    { "type": "text", "id": "small", "label": "Small print", "default": "By subscribing you agree to receive marketing emails. Unsubscribe anytime." }
  ],
  "presets": [{ "name": "Luxebin newsletter" }]
}
{% endschema %}
