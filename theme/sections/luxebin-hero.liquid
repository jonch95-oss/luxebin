{{ 'luxebin-sections.css' | asset_url | stylesheet_tag }}
<section class="lx-hero" aria-label="{{ section.settings.eyebrow | escape }}">
  <div class="lx-hero__arc" aria-hidden="true"></div>
  <div class="lx-wrap lx-hero__grid">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="lx-caps lx-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="h0">
        {{- section.settings.heading -}}
        {%- if section.settings.heading_em != blank -%}<br><em>{{ section.settings.heading_em }}</em>{%- endif -%}
      </h2>
      {%- if section.settings.text != blank -%}
        <p class="lx-hero__text">{{ section.settings.text }}</p>
      {%- endif -%}
      <div class="lx-btns">
        {%- if section.settings.button_label != blank -%}
          <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.button_2_label != blank -%}
          <a class="button button--secondary lx-btn-ghost" href="{{ section.settings.button_2_link }}">{{ section.settings.button_2_label }}</a>
        {%- endif -%}
      </div>
    </div>
    <div class="lx-stage" aria-hidden="true">
      <div class="lx-plinth"></div>
      {%- for i in (1..4) -%}
        {%- liquid
          assign key = 'product_' | append: i
          assign p = section.settings[key]
          assign img_class = 'lx-s' | append: i
        -%}
        {%- if p != blank and p.featured_media -%}
          {{
            p.featured_media.preview_image
            | image_url: width: 900
            | image_tag:
              class: img_class,
              alt: '',
              loading: 'eager',
              fetchpriority: 'high',
              widths: '450, 700, 900',
              sizes: '(min-width: 990px) 30vw, 50vw'
          }}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
<style>
  .lx-hero h2.h0 { font-family: var(--lx-serif); font-weight: 400; font-size: clamp(4.4rem, 5.6vw, 8rem); line-height: 1.02; letter-spacing: -0.01em; margin: 2rem 0 2.2rem; }
  .lx-hero h2.h0 em { color: var(--lx-accent-deep); font-style: italic; }
</style>

{% schema %}
{
  "name": "Luxebin hero",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Autumn Edit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Prestige," },
    { "type": "text", "id": "heading_em", "label": "Heading (italic line)", "default": "minus the premium." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Rare Beauty, Laura Mercier, Laneige and the names you already love. 100% authentic, and always below retail." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the Edit" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button_2_label", "label": "Second button label", "default": "Our Authenticity Promise" },
    { "type": "url", "id": "button_2_link", "label": "Second button link" },
    { "type": "header", "content": "Product still life (use cut-out packshots)" },
    { "type": "product", "id": "product_1", "label": "Product 1" },
    { "type": "product", "id": "product_2", "label": "Product 2" },
    { "type": "product", "id": "product_3", "label": "Product 3" },
    { "type": "product", "id": "product_4", "label": "Product 4" }
  ],
  "presets": [{ "name": "Luxebin hero" }]
}
{% endschema %}
